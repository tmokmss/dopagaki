---
import { href } from '../lib/url';

interface Props {
  title: string;
  /** false にするとトップへ戻るリンクを出さない */
  back?: boolean;
  /**
   * true にするとページをスクロールできるようにする (トップページ用)。
   * 既定 (false) では画面ぴったりに固定し、スクロール・ズーム・バウンスを止める。
   * 子どもの指はタップ中にずれやすく、スクロール扱いになってタップが効かなくなるため。
   */
  scroll?: boolean;
}
const { title, back = true, scroll = false } = Astro.props;
---
<!doctype html>
<html lang="ja" class={scroll ? 'scroll' : 'fit'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FAF9F5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1F1E1C" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href={href('manifest.webmanifest')} />
    <link rel="icon" href={href('icons/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('icons/apple-touch-icon.png')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="まちじかん" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{title}</title>
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ sw: href('sw.js'), scope: href() }}>
        if ('serviceWorker' in navigator) {
          // キャッシュ優先なので、新しい版が入ってもこのページは古いまま表示されている。
          // まだ触っていなければすぐリロードして新しい版にする。遊んでいる途中なら中断させず、次のページ遷移で切り替わる
          const hadController = !!navigator.serviceWorker.controller;
          let touched = false;
          addEventListener('pointerdown', () => { touched = true; }, { once: true, capture: true });
          navigator.serviceWorker.addEventListener('controllerchange', () => {
            if (hadController && !touched) location.reload();
          });
          navigator.serviceWorker.register(sw, { scope });
        }
      </script>
    )}
  </head>
  <body>
    <main>
      {back && <a class="back" href={href()} aria-label="もどる">‹ もどる</a>}
      <slot />
    </main>
  </body>
</html>

<script>
  if (document.documentElement.classList.contains('fit')) {
    // iOS Safari は touch-action / overscroll-behavior だけではバウンスやピンチを止めきれないので JS でも止める
    const stop = (e: Event) => e.preventDefault();
    document.addEventListener('touchmove', stop, { passive: false });
    document.addEventListener('gesturestart', stop);
    document.addEventListener('contextmenu', stop);

    // 100dvh は Android Chrome などで実際に見えている高さより大きくなり、下が画面外に切れることがある。
    // 見えている高さを JS で測って --app-h に入れ、body の高さに使う
    const root = document.documentElement;
    const setH = () => {
      const h = Math.min(innerHeight, visualViewport?.height ?? innerHeight, root.clientHeight);
      root.style.setProperty('--app-h', `${h}px`);
    };
    setH();
    addEventListener('resize', setH);
    visualViewport?.addEventListener('resize', setH);
  }

  // URL に ?debug を付けると、画面の高さまわりの値を表示する (実機でレイアウトが崩れたときの調査用)
  if (new URLSearchParams(location.search).has('debug')) {
    const probe = (css: string) => {
      const d = document.createElement('div');
      d.style.cssText = `position:fixed;left:0;top:0;width:0;visibility:hidden;${css}`;
      document.body.appendChild(d);
      return d;
    };
    const dvh = probe('height:100dvh'), svh = probe('height:100svh'), lvh = probe('height:100lvh');
    const inset = probe('height:env(safe-area-inset-bottom, 0px)');
    const box = document.createElement('pre');
    box.style.cssText = 'position:fixed;left:4px;top:4px;z-index:9999;margin:0;padding:6px;font:12px/1.4 monospace;background:rgba(0,0,0,.75);color:#fff;border-radius:4px;pointer-events:none';
    document.body.appendChild(box);
    const show = () => {
      box.textContent = [
        `innerHeight ${innerHeight}`,
        `visualViewport ${visualViewport?.height.toFixed(1)}`,
        `html.clientHeight ${document.documentElement.clientHeight}`,
        `body ${document.body.getBoundingClientRect().height.toFixed(1)}`,
        `100dvh ${dvh.offsetHeight} / svh ${svh.offsetHeight} / lvh ${lvh.offsetHeight}`,
        `safe-bottom ${inset.offsetHeight}`,
        `screen ${screen.height} dpr ${devicePixelRatio}`,
      ].join('\n');
    };
    show();
    addEventListener('resize', show);
    visualViewport?.addEventListener('resize', show);
  }
</script>

<style is:global>
  :root {
    --surface-0: #FAF9F5;
    --surface-1: #F1EFE8;
    --text-primary: #1F1E1C;
    --text-secondary: #5F5E5A;
    --text-success: #3B6D11;
    --border-strong: rgba(0, 0, 0, .2);
    --border-accent: #378ADD;
    --radius: 8px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --surface-0: #1F1E1C;
      --surface-1: #2C2C2A;
      --text-primary: #F1EFE8;
      --text-secondary: #B4B2A9;
      --text-success: #97C459;
      --border-strong: rgba(255, 255, 255, .25);
      --border-accent: #85B7EB;
    }
  }
  * {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    user-select: none;
    -webkit-user-select: none;
  }
  body {
    margin: 0;
    padding: calc(16px + env(safe-area-inset-top, 0px)) 16px calc(16px + env(safe-area-inset-bottom, 0px));
    font-family: system-ui, -apple-system, "Hiragino Sans", sans-serif;
    color: var(--text-primary);
    background: var(--surface-0);
  }
  main { max-width: 520px; margin: 0 auto; }

  /* 画面ぴったりモード: main を縦並びの flex にし、.grow を付けた要素が残りの高さを埋める */
  html.fit, html.fit body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;
  }
  html.fit body { height: var(--app-h, 100dvh); }
  html.fit main { height: 100%; display: flex; flex-direction: column; }
  html.fit main > * { flex-shrink: 0; }
  html.fit main > .grow { flex: 1 1 0; min-height: 0; }

  button {
    font: inherit;
    color: inherit;
    background: transparent;
    border: 0.5px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 8px 14px;
    cursor: pointer;
    touch-action: manipulation;
  }
  html.fit button { touch-action: none; }
  button:active { transform: scale(.98); }
  .back {
    align-self: flex-start;
    display: inline-block;
    margin-bottom: 8px;
    font-size: 14px;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .hud {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    font-size: 22px;
    font-weight: 500;
  }
</style>
