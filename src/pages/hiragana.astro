---
import GameLayout from '../layouts/GameLayout.astro';
---
<GameLayout title="もじの たまご">
  <div class="hud">
    <span>ずかん: <span id="cnt">0</span> / <span id="goal"></span></span>
    <button id="rst" style="font-size:16px;font-weight:400">もういちど</button>
  </div>
  <div id="nest" class="grow">
    <div id="full" hidden>
      <div class="emo">🎉</div>
      <h2>ずかん いっぱい！</h2>
      <button id="again">もういっかい</button>
    </div>
  </div>
  <div id="book"></div>
</GameLayout>

<style is:global>
  /* たまごを 2×2 に並べる。大きさは #nest に合わせる */
  #nest {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    place-items: center;
    container-type: size;
  }
  .egg {
    position: relative;
    /* たまごの縦横比 100:128 */
    width: min(42cqw, 45cqh * 100 / 128);
    aspect-ratio: 100 / 128;
    container-type: inline-size;
    cursor: pointer;
  }
  .egg svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .egg .top, .egg .bottom { transform-box: fill-box; }
  .egg .crack { opacity: 0; }
  .egg.cracked .crack { opacity: 1; }
  .egg.cracked { animation: wobble .5s ease-in-out; }
  .egg.drop { animation: edrop .45s cubic-bezier(.3, 1.4, .5, 1); }
  .egg .k {
    position: absolute;
    left: 0; right: 0; top: 46%; height: 42%;
    display: flex; align-items: center; justify-content: center;
    font-family: "Hiragino Maru Gothic ProN", "Hiragino Sans", "Noto Sans JP", system-ui, sans-serif;
    font-size: 50cqw;
    font-weight: 700;
    line-height: 1;
    color: var(--c);
    pointer-events: none;
  }
  .egg .pic {
    position: absolute;
    left: 0; right: 0; top: 4%;
    text-align: center;
    font-family: "Apple Color Emoji", "Noto Color Emoji", "Segoe UI Emoji", sans-serif;
    font-size: 62cqw;
    line-height: 1;
    transform: scale(0);
    pointer-events: none;
  }
  .egg.open .top { animation: lid .5s ease-out forwards; }
  .egg.open .k { opacity: 0; transition: opacity .2s; }
  .egg.open .pic { animation: hatch .55s cubic-bezier(.3, 1.6, .5, 1) forwards; }
  @keyframes wobble { 20% { transform: rotate(-9deg) } 45% { transform: rotate(8deg) } 70% { transform: rotate(-4deg) } }
  @keyframes edrop { from { transform: translateY(-40cqh) scale(.6); opacity: 0 } to { transform: none; opacity: 1 } }
  @keyframes lid { to { transform: translate(-30%, -70%) rotate(-35deg); opacity: 0 } }
  @keyframes hatch { from { transform: translateY(40%) scale(0) } to { transform: translateY(-10%) scale(1) } }

  /* ずかん: 5 × 2 マス */
  #book {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    margin-top: 12px;
    padding: 8px;
    border-radius: 16px;
    background: var(--surface-1);
  }
  #book .slot {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    height: 58px;
    border: 2px dashed var(--border-strong);
    border-radius: 12px;
    cursor: pointer;
  }
  #book .slot.got { border: 0; background: var(--surface-0); }
  #book .slot.got.pop { animation: spop .4s cubic-bezier(.3, 1.6, .5, 1); }
  #book .slot .e { font-family: "Apple Color Emoji", "Noto Color Emoji", "Segoe UI Emoji", sans-serif; font-size: 30px; line-height: 1; }
  #book .slot .s { font-family: "Hiragino Maru Gothic ProN", "Hiragino Sans", system-ui, sans-serif; font-size: 13px; font-weight: 700; line-height: 1.2; }
  #book.done .slot { animation: fjump .5s ease-out 2; }
  #book.done .slot:nth-child(even) { animation-delay: .1s; }
  @keyframes spop { from { transform: scale(.3) } to { transform: none } }
  @keyframes fjump { 50% { transform: translateY(-8px) } }

  .fly {
    position: fixed;
    z-index: 5;
    font-family: "Apple Color Emoji", "Noto Color Emoji", "Segoe UI Emoji", sans-serif;
    line-height: 1;
    pointer-events: none;
  }

  /* GOAL こ集めたらおしまい */
  #full { position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; border-radius: 16px; background: var(--surface-1); animation: fpop .5s cubic-bezier(.3, 1.6, .5, 1); }
  #full[hidden] { display: none; }
  #full .emo { font-family: "Apple Color Emoji", "Noto Color Emoji", "Segoe UI Emoji", sans-serif; font-size: min(96px, 30cqh); line-height: 1; }
  #full h2 { margin: 0; font-family: "Hiragino Maru Gothic ProN", "Hiragino Sans", system-ui, sans-serif; font-size: 28px; }
  #full button { background: #E24B4A; color: #fff; font-size: 22px; padding: 10px 32px; border-radius: 999px; }
  @keyframes fpop { from { transform: scale(.4); opacity: 0; } to { transform: none; opacity: 1; } }
</style>

<script>
  import { chirp, tone } from '../lib/audio';
  import { canSpeak, speak, speakWait } from '../lib/speech';
  import { onTap } from '../lib/tap';

  // [もじ, ことば, えもじ]  「を」「ん」ではじまることばはないので入れない
  // ことばは読み上げ専用で画面には出さないので、ひらがなにせず漢字・カタカナで書く (src/lib/speech.ts の speak を参照)
  // 漢字 1 文字だけだと音読み・訓読みを取り違える (魚→「うお」、卵→「ラン」) ので、1 文字の語はカタカナにする
  const KANA: [string, string, string][] = [
    ['あ', 'アリ', '🐜'], ['い', 'イヌ', '🐕'], ['う', 'ウサギ', '🐇'], ['え', '鉛筆', '✏️'], ['お', 'お握り', '🍙'],
    ['か', 'カニ', '🦀'], ['き', 'キリン', '🦒'], ['く', 'クマ', '🐻'], ['け', 'ケーキ', '🍰'], ['こ', 'コアラ', '🐨'],
    ['さ', 'サカナ', '🐟'], ['し', 'シカ', '🦌'], ['す', 'スイカ', '🍉'], ['せ', '石鹸', '🧼'], ['そ', 'ソフトクリーム', '🍦'],
    ['た', 'タマゴ', '🥚'], ['ち', '蝶々', '🦋'], ['つ', 'ツキ', '🌙'], ['て', 'テントウムシ', '🐞'], ['と', 'トマト', '🍅'],
    ['な', 'ナス', '🍆'], ['に', '人参', '🥕'], ['ぬ', '縫いぐるみ', '🧸'], ['ね', 'ネコ', '🐈'], ['の', 'ノコギリ', '🪚'],
    ['は', 'ハナ', '🌷'], ['ひ', 'ヒヨコ', '🐤'], ['ふ', 'フネ', '🚢'], ['へ', 'ヘビ', '🐍'], ['ほ', 'ホシ', '⭐'],
    ['ま', 'マイク', '🎤'], ['み', 'ミカン', '🍊'], ['む', 'ムシ', '🐛'], ['め', '眼鏡', '👓'], ['も', 'モモ', '🍑'],
    ['や', 'ヤマ', '⛰️'], ['ゆ', '雪だるま', '⛄'], ['よ', 'ヨット', '⛵'],
    ['ら', 'ライオン', '🦁'], ['り', 'リンゴ', '🍎'], ['る', 'ルーペ', '🔍'], ['れ', 'レモン', '🍋'], ['ろ', 'ロケット', '🚀'],
    ['わ', 'ワニ', '🐊'],
  ];
  // 行ごとの色 (あ行, か行, ... わ行)
  const ROW_COLORS = ['#E24B4A', '#EF9F27', '#639922', '#378ADD', '#D4537E', '#7F5BC7', '#1D9E8F', '#D85A30', '#3B6D11', '#185FA5'];
  const rowOf = (i: number) => (i < 35 ? Math.floor(i / 5) : i < 38 ? 7 : i < 43 ? 8 : 9);
  // 3 歳が数えきれて、待ち時間に収まる数
  const GOAL = 10;
  const EGGS = 4;

  const nest = document.getElementById('nest')!;
  const book = document.getElementById('book')!;
  const full = document.getElementById('full')!;
  const cntEl = document.getElementById('cnt')!;
  document.getElementById('goal')!.textContent = String(GOAL);

  // たまごの絵。ヒビの線で上下に分け、割れたら上だけ飛ばす
  const EGG = 'M50 4 C78 4 96 50 96 80 C96 108 76 124 50 124 C24 124 4 108 4 80 C4 50 22 4 50 4Z';
  const ZIG = '4,50 16,42 28,54 40,42 52,54 64,42 76,54 88,42 96,50';
  const eggSvg = (c: string, id: number) => `<svg viewBox="0 0 100 128">
    <defs>
      <clipPath id="t${id}"><polygon points="0,0 100,0 100,50 ${ZIG.split(' ').reverse().join(' ')} 0,50"/></clipPath>
      <clipPath id="e${id}"><path d="${EGG}"/></clipPath>
      <clipPath id="b${id}"><polygon points="0,128 100,128 100,50 ${ZIG.split(' ').reverse().join(' ')} 0,50"/></clipPath>
    </defs>
    <g class="bottom" clip-path="url(#b${id})"><path d="${EGG}" fill="#FFF8EC" stroke="${c}" stroke-width="3"/></g>
    <g class="top" clip-path="url(#t${id})">
      <path d="${EGG}" fill="#FFF8EC" stroke="${c}" stroke-width="3"/>
      <circle cx="32" cy="26" r="6" fill="${c}" opacity=".35"/><circle cx="62" cy="18" r="4" fill="${c}" opacity=".35"/><circle cx="70" cy="36" r="5" fill="${c}" opacity=".35"/>
    </g>
    <polyline class="crack" clip-path="url(#e${id})" points="${ZIG}" fill="none" stroke="#5F5E5A" stroke-width="3" stroke-linejoin="round"/>
  </svg>`;

  interface Egg { el: HTMLDivElement; id: number; i: number; state: 'whole' | 'cracked' | 'open' }
  const eggs: Egg[] = [];
  let got: number[] = [];
  let done = false;
  // 読み上げ中は たまご と ずかん のタップを受け付けない。連打で声が途切れ途切れになるのを防ぐ
  // 読み上げごとに番号を振り、いま鳴っているものが終わったときだけ解除する
  let talking = 0;
  let talkSeq = 0;

  /** 見えているたまごとずかんに無いもじを選ぶ */
  function pickKana() {
    const used = new Set([...eggs.map((e) => e.i), ...got]);
    const free = KANA.map((_, i) => i).filter((i) => !used.has(i));
    return free[Math.floor(Math.random() * free.length)];
  }

  function setEgg(egg: Egg) {
    egg.i = pickKana();
    egg.state = 'whole';
    const c = ROW_COLORS[rowOf(egg.i)];
    const [k, , e] = KANA[egg.i];
    egg.el.style.setProperty('--c', c);
    egg.el.className = 'egg';
    egg.el.innerHTML = `${eggSvg(c, egg.id)}<span class="k">${k}</span><span class="pic">${e}</span>`;
    void egg.el.offsetWidth;
    egg.el.classList.add('drop');
  }

  /** texts を読み上げ、終わるまでタップを止める。日本語の声がない端末では効果音を鳴らし、その間だけ止める */
  function talk(texts: string[], fallback: () => void) {
    const id = (talking = ++talkSeq);
    const unlock = () => {
      if (talking === id) talking = 0;
    };
    if (canSpeak()) speakWait(...texts).then(unlock);
    else {
      fallback();
      setTimeout(unlock, 400);
    }
  }

  /** 読み上げ中にタップされたら、受け付けていないことが分かるように小さく揺らすだけにする */
  function nudge(el: Element) {
    el.animate(
      [{ transform: 'none' }, { transform: 'rotate(-4deg)' }, { transform: 'rotate(4deg)' }, { transform: 'none' }],
      { duration: 250, easing: 'ease-in-out' },
    );
  }

  function say(i: number, withKana: boolean) {
    const [k, w] = KANA[i];
    talk(withKana ? [k, w] : [w], () => chirp(400 + (i % 10) * 60));
  }

  function tapEgg(egg: Egg) {
    if (done || egg.state === 'open') return;
    if (talking) return nudge(egg.el);
    const [k] = KANA[egg.i];
    if (egg.state === 'whole') {
      // 1 回目: ぐらっと揺れてヒビが入る
      egg.state = 'cracked';
      egg.el.classList.remove('drop');
      egg.el.classList.add('cracked');
      tone(330, 0, 0.08, 0.2, 'triangle');
      tone(440, 0.1, 0.08, 0.2, 'triangle');
      talk([k], () => chirp(300 + (egg.i % 10) * 40));
      return;
    }
    // 2 回目: パカッと割れて出てくる
    if (got.length >= GOAL) return;
    egg.state = 'open';
    const slot = got.length;
    got.push(egg.i);
    egg.el.classList.add('open');
    chirp(500 + (slot % 8) * 80);
    say(egg.i, true);
    setTimeout(() => collect(egg, slot), 1400);
  }

  /** 出てきた絵をずかんへ飛ばし、あいた所に新しいたまごを置く */
  function collect(egg: Egg, slot: number) {
    const i = egg.i;
    const pic = egg.el.querySelector<HTMLElement>('.pic')!;
    const to = book.children[slot] as HTMLElement;
    const a = pic.getBoundingClientRect(), b = to.getBoundingClientRect();
    const fly = document.createElement('div');
    fly.className = 'fly';
    fly.textContent = KANA[i][2];
    const size = parseFloat(getComputedStyle(pic).fontSize);
    fly.style.cssText = `left:${a.left + a.width / 2 - size / 2}px;top:${a.top}px;font-size:${size}px`;
    document.body.appendChild(fly);
    const dx = b.left + b.width / 2 - (a.left + a.width / 2), dy = b.top + b.height / 2 - (a.top + size / 2);
    fly.animate([{ transform: 'none' }, { transform: `translate(${dx}px, ${dy}px) scale(${30 / size})` }], { duration: 500, easing: 'ease-in' }).onfinish = () => {
      fly.remove();
      fillSlot(slot, i);
    };
    if (got.length >= GOAL) {
      done = true;
      setTimeout(finish, 700);
    } else setEgg(egg);
  }

  function fillSlot(slot: number, i: number) {
    const [k, , e] = KANA[i];
    const s = book.children[slot] as HTMLElement;
    s.className = 'slot got pop';
    s.dataset.i = String(i);
    s.innerHTML = `<span class="e">${e}</span><span class="s" style="color:${ROW_COLORS[rowOf(i)]}">${k}</span>`;
    tone(880 + slot * 40, 0, 0.12, 0.15);
    cntEl.textContent = String(slot + 1);
  }

  /** ずかん いっぱい。集めた絵は残して「どれが すき?」と話せるようにする */
  function finish() {
    full.hidden = false;
    book.classList.add('done');
    [523, 659, 784].forEach((f) => tone(f, 0, 0.6, 0.12));
    tone(1047, 0.12, 0.7, 0.12);
    speak('図鑑 いっぱい！', 'どれが 好き？');
  }

  function reset() {
    if (done && full.hidden) return; // finish 待ちの間は無視する
    done = false;
    talking = 0;
    got = [];
    cntEl.textContent = '0';
    full.hidden = true;
    book.classList.remove('done');
    book.innerHTML = '';
    for (let n = 0; n < GOAL; n++) {
      const s = document.createElement('div');
      s.className = 'slot';
      book.appendChild(s);
    }
    for (const egg of eggs) egg.i = -1;
    for (const egg of eggs) setEgg(egg);
  }

  for (let n = 0; n < EGGS; n++) {
    const el = document.createElement('div');
    const egg: Egg = { el, id: n, i: -1, state: 'whole' };
    nest.appendChild(el);
    eggs.push(egg);
    onTap(el, () => tapEgg(egg));
  }
  // ずかんのマスをタップすると、もういちど読む
  onTap(book, (_, e) => {
    const s = (e.target as Element).closest<HTMLElement>('.slot.got');
    if (!s) return;
    if (talking) return nudge(s);
    say(Number(s.dataset.i), false);
    s.classList.remove('pop');
    void s.offsetWidth;
    s.classList.add('pop');
  });
  onTap('#rst', reset);
  onTap('#again', reset);
  reset();
</script>
