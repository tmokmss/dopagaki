---
import GameLayout from '../layouts/GameLayout.astro';
import { games } from '../games';
import { execSync } from 'node:child_process';
import { href } from '../lib/url';

// いま見えている版がどれか分かるよう、ビルド時のコミットハッシュを左下に出す
const commit = (process.env.GITHUB_SHA ?? execSync('git rev-parse HEAD').toString()).trim().slice(0, 7);
---
<GameLayout title="こどもの待ち時間ゲーム" back={false} scroll>
  <div class="top">
    <h1>まちじかん ゲーム</h1>
    <a class="stats" href={href('stats/')}>きろく</a>
  </div>
  <ul class="list">
    {games.map((g) => (
      <li>
        <a href={href(`${g.slug}/`)}>
          <span class="icon">{g.icon}</span>
          <span>
            <span class="title">{g.title}</span>
            <span class="desc">{g.place} ・ {g.description}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p class="version">{commit}</p>
</GameLayout>

<style>
  .top { display: flex; align-items: baseline; justify-content: space-between; margin: 8px 0 16px; }
  h1 { font-size: 24px; font-weight: 500; margin: 0; }
  /* 親向けなので、子どもが押しにくいよう小さく目立たなくする */
  .top a.stats { display: inline; padding: 4px 0; background: none; font-size: 13px; color: var(--text-secondary); text-decoration: underline; }
  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px;
    border-radius: 12px;
    background: var(--surface-1);
    color: inherit;
    text-decoration: none;
  }
  a:active { transform: scale(.98); }
  .icon { font-size: 44px; line-height: 1; }
  .title { display: block; font-size: 20px; font-weight: 500; }
  .desc { display: block; font-size: 13px; color: var(--text-secondary); margin-top: 4px; }
  .version {
    position: fixed;
    left: calc(env(safe-area-inset-left, 0px) + 6px);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 4px);
    margin: 0;
    font: 11px/1 monospace;
    color: var(--text-secondary);
    opacity: .6;
    pointer-events: none;
  }
</style>
