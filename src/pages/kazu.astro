---
import GameLayout from '../layouts/GameLayout.astro';
---
<GameLayout title="かずあそび">
  <div id="board" aria-label="すごろく"></div>
  <button id="prompt" aria-label="もういちど きく"><span id="pnum"></span><span id="ptext"></span></button>
  <div id="stage" class="grow"></div>
  <p id="hint"></p>
</GameLayout>

<!--
  設計の根拠は docs/number-game-survey.md。要点:
  - 3歳は 1〜3 (〜5) の「量 ⇔ 数詞」が主戦場。数字は常に量・音声と並べて出す
  - 毎回「かぞえる → ぜんぶで ○こ」をセットにする
  - 触るのは数える物そのもの。どこを触っても進む UI にしない
  - 想起は 2〜3 択とちょうだい課題。間違えても罰せず、一緒に数え直す
  - 1〜10 の直線すごろくで、進むときはマスの数を読む (今いるマスから数え足す)
  - ゴールしたらその日はおしまい。コインやスタンプなどのごほうびは付けない
-->

<style is:global>
  #board {
    display: flex;
    gap: 2px;
    height: 58px;
    margin-bottom: 8px;
  }
  .cell {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 4px;
    border-radius: 8px;
    background: var(--surface-1);
    font-family: "Hiragino Maru Gothic ProN", "Hiragino Sans", "Noto Sans JP", system-ui, sans-serif;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
  }
  .cell.passed { background: #FAC775; color: #1F1E1C; }
  .cell.goal { background: #C0DD97; color: #1F1E1C; }
  .cell.next { outline: 3px solid var(--border-accent); outline-offset: -3px; animation: kpulse 1s infinite; }
  .piece {
    position: absolute;
    top: 3px;
    font-family: "Apple Color Emoji", "Noto Color Emoji", "Segoe UI Emoji", sans-serif;
    font-size: 22px;
  }
  .piece.hop { animation: khop .35s ease-out; }

  #prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    height: 64px;
    margin-bottom: 10px;
    padding: 0 14px;
    border: 0;
    border-radius: 16px;
    background: var(--surface-1);
    font-family: "Hiragino Maru Gothic ProN", "Hiragino Sans", "Noto Sans JP", system-ui, sans-serif;
    font-size: 22px;
    font-weight: 700;
    text-align: left;
  }
  #pnum { display: flex; align-items: center; gap: 2px; }
  #pnum b { font-size: 46px; line-height: 1; color: #E24B4A; }
  #pnum .hand { width: 38px; height: 46px; }

  #stage { container-type: size; }
  #stage.dim > * { opacity: .45; }
  #hint {
    height: 2.8em;
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-secondary);
  }

  .obj {
    position: relative;
    padding: 1cqw;
    border: 0;
    border-radius: 16px;
    background: transparent;
    font-family: "Apple Color Emoji", "Noto Color Emoji", "Segoe UI Emoji", sans-serif;
    line-height: 1;
  }
  .obj.counted { background: #FAEEDA; }
  .obj.pop { animation: kpop .3s cubic-bezier(.3, 1.6, .5, 1); }
  .hl { transform: scale(1.25); background: #FAEEDA; border-radius: 16px; transition: transform .15s; }
  .badge {
    position: absolute;
    top: -.15em;
    right: -.15em;
    display: grid;
    place-items: center;
    min-width: 1.5em;
    height: 1.5em;
    border-radius: 999px;
    background: #E24B4A;
    color: #fff;
    font-family: "Hiragino Maru Gothic ProN", "Hiragino Sans", system-ui, sans-serif;
    font-size: .32em;
    font-weight: 700;
  }

  /* かぞえる */
  .count { height: 100%; display: flex; flex-direction: column; }
  .count .row { flex: 1 1 55%; display: flex; align-items: center; justify-content: center; gap: 2cqw; }
  .count .obj { font-size: min(15cqw, 26cqh); }
  .count .row.all .obj { animation: kjump .5s ease-out; }
  .result {
    flex: 1 1 45%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3cqw;
    font-family: "Hiragino Maru Gothic ProN", "Hiragino Sans", "Noto Sans JP", system-ui, sans-serif;
    font-size: min(8cqw, 10cqh);
    font-weight: 700;
  }
  .result b { font-size: 2.6em; line-height: 1; color: #E24B4A; }
  .result .hand { width: 2.2em; height: 2.7em; }
  /* 下端に接しているので、1 倍を超えて弾ませない (はみ出すため) */
  .result.show { animation: kpop .4s ease-out; }

  /* えらぶ */
  .choose { height: 100%; display: flex; align-items: center; justify-content: center; gap: 4cqw; }
  .card {
    display: grid;
    grid-template: repeat(3, 1fr) / repeat(3, 1fr);
    width: 29cqw;
    height: min(62cqh, 36cqw);
    padding: 2cqw;
    border: 4px solid transparent;
    border-radius: 18px;
    background: var(--surface-1);
  }
  .choose.k2 .card { width: 40cqw; height: min(70cqh, 44cqw); }
  .card span {
    display: grid;
    place-items: center;
    font-family: "Apple Color Emoji", "Noto Color Emoji", "Segoe UI Emoji", sans-serif;
    font-size: min(7cqw, 12cqh);
    line-height: 1;
  }
  .choose.k2 .card span { font-size: min(9cqw, 14cqh); }
  .card.right { border-color: #639922; background: #EAF3DE; }
  .card.hintme { border-color: var(--border-accent); animation: kpulse 1s infinite; }
  .card.shake { animation: kshake .4s; }

  /* ちょうだい */
  .give { height: 100%; display: grid; grid-template-rows: 1fr 1fr auto; gap: 2cqh; }
  .pile, .plate { display: flex; flex-wrap: wrap; align-content: center; justify-content: center; gap: 1cqw; }
  .plate { border: 3px dashed var(--border-strong); border-radius: 50% / 45%; background: var(--surface-1); }
  .give .obj { font-size: min(10cqw, 15cqh); }
  .give .ok, .panel .go {
    justify-self: center;
    padding: 10px 28px;
    border: 0;
    border-radius: 999px;
    background: #378ADD;
    color: #fff;
    font-family: "Hiragino Maru Gothic ProN", "Hiragino Sans", "Noto Sans JP", system-ui, sans-serif;
    font-size: 22px;
    font-weight: 700;
  }

  /* はじめ・おわり */
  .panel { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; text-align: center; }
  .panel .emo { font-family: "Apple Color Emoji", "Noto Color Emoji", "Segoe UI Emoji", sans-serif; font-size: min(24cqw, 26cqh); line-height: 1; }
  .panel h2 { margin: 0; font-family: "Hiragino Maru Gothic ProN", "Hiragino Sans", system-ui, sans-serif; font-size: 24px; }
  .panel p { max-width: 30em; margin: 0; font-size: 13px; line-height: 1.5; color: var(--text-secondary); }
  .panel .go { background: #E24B4A; font-size: 26px; padding: 14px 40px; }
  .panel .again { font-size: 14px; color: var(--text-secondary); }

  @keyframes kpop { from { transform: scale(.4); } to { transform: none; } }
  @keyframes khop { 0% { transform: translateY(0); } 50% { transform: translateY(-12px); } 100% { transform: translateY(0); } }
  @keyframes kjump { 50% { transform: translateY(-14%); } }
  @keyframes kpulse { 50% { opacity: .55; } }
  @keyframes kshake { 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
</style>

<script>
  import { chirp, tone } from '../lib/audio';
  import { speak, speakWait } from '../lib/speech';
  import { onTap } from '../lib/tap';

  type Item = [emoji: string, name: string];
  type Task = 'count' | 'choose' | 'give';

  const WORD = ['ぜろ', 'いち', 'に', 'さん', 'よん', 'ご', 'ろく', 'なな', 'はち', 'きゅう', 'じゅう'];
  // 助数詞は「こ」にそろえる (数え方が混ざると 3 歳には負担なので、どれも「こ」で数えられる物にする)
  const KO = ['', 'いっこ', 'にこ', 'さんこ', 'よんこ', 'ごこ', 'ろっこ', 'ななこ'];
  const ITEMS: Item[] = [
    ['🍎', 'りんご'], ['🍓', 'いちご'], ['🍊', 'みかん'], ['🍙', 'おにぎり'],
    ['🍩', 'ドーナツ'], ['🍪', 'クッキー'], ['🍬', 'あめ'], ['⭐', 'ほし'],
  ];
  // サイコロの目の並び (3×3 のマスの何番目に置くか)。整った並びの方が 3 歳でも数を把握しやすい
  const DICE = [[], [4], [0, 8], [0, 4, 8], [0, 2, 6, 8], [0, 2, 4, 6, 8], [0, 2, 3, 5, 6, 8]];
  const GOAL = 10;
  const MIN_MAX = 2, MAX_MAX = 5;

  const $ = (id: string) => document.getElementById(id)!;
  const board = $('board'), promptEl = $('prompt'), pnum = $('pnum'), ptext = $('ptext');
  const stage = $('stage'), hint = $('hint');

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const rand = (n: number) => Math.floor(Math.random() * n);
  const shuffle = <T,>(a: T[]) => {
    for (let i = a.length - 1; i > 0; i--) {
      const j = rand(i + 1);
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  };
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  }
  function restart(e: Element, cls: string) {
    e.classList.remove(cls);
    void (e as HTMLElement).offsetWidth;
    e.classList.add(cls);
  }

  // ---- 進み具合の保存 (端末ごと。見られなくても遊べる) ----

  interface Save {
    /** 出題する数の上限。子どもが分かっている数の範囲の推定 */
    max: number;
    /** 数ごとの最近の結果 (1: 1回目で正解, 0: まちがえた) */
    hist: Record<number, number[]>;
    /** 数に関係なく最近の結果 */
    recent: number[];
    last?: string;
  }
  const KEY = 'kazu:v1';
  let S: Save = { max: 3, hist: {}, recent: [] };
  try {
    const s = JSON.parse(localStorage.getItem(KEY) ?? 'null');
    if (s && typeof s.max === 'number') S = { ...S, ...s };
  } catch {}
  const save = () => {
    try { localStorage.setItem(KEY, JSON.stringify(S)); } catch {}
  };
  const today = () => new Date().toLocaleDateString('sv');

  const acc = (n: number) => {
    const h = S.hist[n];
    return h?.length ? h.reduce((a, b) => a + b, 0) / h.length : 0.5;
  };

  /** 想起課題の結果から難しさを調整する。まちがいが続いたら範囲を狭め、上限の数が続けてできたら広げる */
  function record(n: number, ok: boolean) {
    S.hist[n] = [...(S.hist[n] ?? []), ok ? 1 : 0].slice(-5);
    S.recent = [...S.recent, ok ? 1 : 0].slice(-4);
    const top = S.hist[S.max] ?? [];
    if (S.recent.length >= 2 && !S.recent.at(-1) && !S.recent.at(-2) && S.max > MIN_MAX) {
      S.max--;
      S.recent = [];
    } else if (S.max < MAX_MAX && top.length >= 3 && top.slice(-3).every(Boolean)) {
      S.max++;
      S.recent = [];
    }
    save();
  }

  /** 次に出す数。直前と同じ数は避け、苦手な数と範囲の上限を多めに出す。1 はかんたんすぎるので少なめ */
  function pickTarget(prev: number) {
    const ns = Array.from({ length: S.max }, (_, i) => i + 1).filter((n) => n !== prev);
    const w = ns.map((n) => (n === 1 ? 0.4 : 1) + (1 - acc(n)) + (n === S.max ? 0.6 : 0));
    let r = Math.random() * w.reduce((a, b) => a + b, 0);
    for (let i = 0; i < ns.length; i++) if ((r -= w[i]) < 0) return ns[i];
    return ns[ns.length - 1];
  }

  // ---- 声と表示 ----

  /** 読み上げて、読み終わるまで待つ。日本語の声がない端末では効果音にする */
  async function say(...texts: string[]) {
    if (!(await speakWait(...texts))) {
      chirp(500);
      await sleep(400 + texts.join('').length * 80);
    }
  }
  function sayNum(k: number) {
    if (!speak(WORD[k])) tone(392 * 2 ** (k / 6));
  }
  async function sayNumWait(k: number) {
    if (!(await speakWait(WORD[k]))) {
      tone(392 * 2 ** (k / 6));
      await sleep(450);
    }
  }

  /** 指で n を出した手の絵。人差し指 → 中指 → 薬指 → 小指 → 親指の順に立てる */
  function hand(n: number) {
    const finger = (x: number, i: number, h: number) =>
      n > i ? `<rect x="${x}" y="${36 - h}" width="9" height="${h + 8}" rx="4.5"/>` : `<rect x="${x}" y="30" width="9" height="12" rx="4.5"/>`;
    const thumb = n > 4
      ? '<rect x="3" y="28" width="9" height="26" rx="4.5" transform="rotate(-28 8 52)"/>'
      : '<rect x="12" y="42" width="9" height="18" rx="4.5" transform="rotate(-62 16 51)"/>';
    return `<svg class="hand" viewBox="0 0 60 72" aria-hidden="true"><g fill="#F6C99B" stroke="#C4895A" stroke-width="1.5">${finger(15, 0, 30)}${finger(25, 1, 33)}${finger(35, 2, 30)}${finger(45, 3, 24)}<rect x="13" y="34" width="42" height="32" rx="12"/>${thumb}</g></svg>`;
  }

  // 上の帯。数字は必ず声といっしょに出す。タップするともう一度読む
  let promptTalk: string[] = [];
  function setPrompt(n: number | null, text: string, talk: string[], withHand = false) {
    pnum.innerHTML = n ? `<b>${n}</b>${withHand ? hand(n) : ''}` : '';
    ptext.textContent = text;
    promptTalk = talk;
  }
  onTap(promptEl, () => promptTalk.length && speak(...promptTalk));

  const setHint = (t: string) => (hint.textContent = t);
  function show(node: HTMLElement) {
    stage.classList.remove('dim');
    stage.replaceChildren(node);
  }

  /** 順に光らせながら「いち、に、さん」と数える */
  async function countAloud(els: Element[]) {
    for (let i = 0; i < els.length; i++) {
      els[i].classList.add('hl');
      await sayNumWait(i + 1);
    }
    await sleep(150);
    els.forEach((e) => e.classList.remove('hl'));
  }

  // ---- すごろく ----

  const cells: HTMLElement[] = [];
  for (let i = 0; i <= GOAL; i++) {
    const c = el('div', i === GOAL ? 'cell goal' : 'cell', i === 0 ? '' : String(i));
    board.append(c);
    cells.push(c);
  }
  const piece = el('span', 'piece', '🐣');
  let pos = 0;
  function place() {
    cells[pos].append(piece);
    cells.forEach((c, i) => c.classList.toggle('passed', i > 0 && i <= pos && i < GOAL));
  }

  let boardWaiter: (() => void) | null = null;
  onTap(board, () => {
    const f = boardWaiter;
    boardWaiter = null;
    f?.();
  });

  /** n マス進む。1 マスずつ子どもがタップして、止まったマスの数を読む (今いるマスから数え足す) */
  async function advance(n: number) {
    stage.classList.add('dim');
    setPrompt(n, `${n} すすもう`, [`${WORD[n]} すすもう`], true);
    setHint('すごろくをタップすると 1 マスずつ進みます。「ご、ろく、なな」と今いるマスから数えます');
    speak(`${WORD[n]} すすもう`);
    for (let s = 0; s < n && pos < GOAL; s++) {
      cells[pos + 1].classList.add('next');
      await new Promise<void>((r) => (boardWaiter = r));
      cells[pos + 1].classList.remove('next');
      pos++;
      place();
      restart(piece, 'hop');
      sayNum(pos);
    }
    await sleep(800);
  }

  // ---- 課題 ----

  /** かぞえる: 物を 1 つずつタップして数え、最後に「ぜんぶで ○こ」と数字・指といっしょに見せる */
  async function countTask(n: number, [emo, name]: Item) {
    setPrompt(null, `${name}を かぞえよう`, [`${name}を かぞえよう`]);
    setHint('いっしょに指さして「いち、に…」と数えてみてください');
    const wrap = el('div', 'count'), row = el('div', 'row'), res = el('div', 'result');
    wrap.append(row, res);
    show(wrap);
    speak(`${name}を かぞえよう`);

    let c = 0;
    await new Promise<void>((resolve) => {
      for (let i = 0; i < n; i++) {
        const b = el('button', 'obj', emo);
        onTap(b, () => {
          // 数え終わった物をもう一度触ったら、その数をもう一度読む
          if (b.dataset.k) return sayNum(+b.dataset.k);
          if (c === n) return;
          b.dataset.k = String(++c);
          b.classList.add('counted');
          b.append(el('span', 'badge', String(c)));
          restart(b, 'pop');
          sayNum(c);
          if (c === n) resolve();
        });
        row.append(b);
      }
    });

    await sleep(700);
    // 最後に言った数が全体の数 (基数) であることを、数字と指の形といっしょに示す
    row.classList.add('all');
    res.innerHTML = `<b>${n}</b>${hand(n)}<span>ぜんぶで ${n}こ</span>`;
    res.classList.add('show');
    chirp(600);
    await say(`ぜんぶで ${KO[n]}`);
    await sleep(500);
  }

  /** えらぶ: 「○こ は どれ？」を 2〜3 枚のカードから選ぶ。まちがえたら、そのカードを一緒に数え直す */
  async function chooseTask(n: number, [emo]: Item) {
    const k = S.max <= 3 ? 2 : 3;
    const others = shuffle(Array.from({ length: Math.min(S.max + 1, 6) }, (_, i) => i + 1).filter((v) => v !== n));
    const vals = shuffle([n, ...others.slice(0, k - 1)]);
    const talk = `${KO[n]} は どれ？`;
    setPrompt(n, `${n}こ は どれ？`, [talk]);
    setHint('まちがえても大丈夫です。一緒に数え直してから、もう一度選びます');

    const wrap = el('div', `choose k${k}`);
    let pick: ((c: HTMLElement) => void) | null = null;
    const cards = vals.map((v) => {
      const c = el('button', 'card');
      c.dataset.v = String(v);
      for (let i = 0; i < 9; i++) c.append(el('span', '', DICE[v].includes(i) ? emo : ''));
      onTap(c, () => {
        const f = pick;
        pick = null;
        f?.(c);
      });
      return c;
    });
    const dots = (c: HTMLElement) => [...c.children].filter((s) => s.textContent);
    wrap.append(...cards);
    show(wrap);
    speak(talk);

    const right = cards[vals.indexOf(n)];
    let first = true;
    for (;;) {
      const c = await new Promise<HTMLElement>((r) => (pick = r));
      if (c === right) break;
      first = false;
      restart(c, 'shake');
      const v = +c.dataset.v!;
      await say('いっしょに かぞえよう');
      await countAloud(dots(c));
      await say(`これは ${KO[v]}`);
      right.classList.add('hintme');
      await say(`${KO[n]} は どれかな？`);
    }
    right.classList.remove('hintme');
    right.classList.add('right');
    chirp(600);
    await countAloud(dots(right));
    await say(first ? `ぴったり ${KO[n]}！ よく みつけたね` : `${KO[n]}、 みつけたね`);
    return first;
  }

  /** ちょうだい: 物をお皿に n こ載せて「はい どうぞ」。まちがえたら一緒に数え直して、もう一度 */
  async function giveTask(n: number, [emo, name]: Item) {
    const talk = `${name}を ${KO[n]} ちょうだい`;
    setPrompt(n, `${name}を ${n}こ ちょうだい`, [talk]);
    setHint('ひとつずつお皿に載せて、載せたら「はい どうぞ」。お皿の物を触ると戻せます');

    const wrap = el('div', 'give'), pile = el('div', 'pile'), plate = el('div', 'plate');
    const ok = el('button', 'ok', 'はい どうぞ');
    wrap.append(pile, plate, ok);
    show(wrap);

    let busy = false;
    const onPlate = () => [...plate.children];
    for (let i = 0; i < Math.min(S.max + 2, 7); i++) {
      const b = el('button', 'obj', emo);
      onTap(b, () => {
        if (busy) return;
        if (b.parentElement === pile) {
          plate.append(b);
          sayNum(onPlate().length);
        } else {
          pile.append(b);
          tone(330, 0, 0.1);
        }
        restart(b, 'pop');
      });
      pile.append(b);
    }
    let submit: (() => void) | null = null;
    onTap(ok, () => {
      if (busy) return;
      if (!onPlate().length) return void speak('おさらに のせてね');
      submit?.();
    });
    speak(talk);

    for (let attempt = 0; ; attempt++) {
      await new Promise<void>((r) => (submit = r));
      busy = true;
      const got = onPlate().length;
      if (got === n) {
        chirp(600);
        await countAloud(onPlate());
        await say(attempt === 0 ? `ぴったり ${KO[n]}！ ひとつずつ のせられたね` : `${KO[n]}、 できたね`);
        return attempt === 0;
      }
      await say('いっしょに かぞえてみよう');
      await countAloud(onPlate());
      await say(`${KO[got]} だね`);
      if (attempt === 0) {
        await say(`${KO[n]} に してね`);
        busy = false;
        continue;
      }
      // 2 回目もちがったら、やってみせる
      while (onPlate().length > n) {
        pile.append(onPlate().at(-1)!);
        await sleep(350);
      }
      while (onPlate().length < n) {
        plate.append(pile.firstElementChild!);
        await sleep(350);
      }
      await countAloud(onPlate());
      await say(`これで ${KO[n]}`);
      return false;
    }
  }

  // ---- 1 回分の流れ ----

  async function session() {
    pos = 0;
    place();
    const order: Task[] = ['count', 'choose', 'give'];
    let prev = 0, prevItem = -1;
    // 1 つ課題ができるたびに、その数だけすごろくを進める。10 に着いたらおしまい (1 回 3〜5 分)
    for (let t = 0; pos < GOAL; t++) {
      const n = pickTarget(prev);
      let ii;
      do ii = rand(ITEMS.length); while (ii === prevItem);
      prev = n;
      prevItem = ii;
      const task = order[t % order.length];
      if (task === 'count') await countTask(n, ITEMS[ii]);
      else record(n, task === 'choose' ? await chooseTask(n, ITEMS[ii]) : await giveTask(n, ITEMS[ii]));
      await advance(n);
    }
    S.last = today();
    save();
    finish();
  }

  function finish() {
    setPrompt(null, 'ゴール！', ['ゴール！ きょうは おしまい。 また あしたね']);
    setHint('');
    const p = el('div', 'panel');
    p.append(
      el('div', 'emo', '🎉'),
      el('h2', '', 'ゴール！ きょうは おしまい'),
      el('p', '', `いまは 1〜${S.max} の数を練習しています。1 日 1 回、数分ずつを毎日続けると覚えやすくなります（間をあけて繰り返すことと、昼寝や夜の睡眠が記憶を助けます）。`),
    );
    const again = el('button', 'again', 'もういっかい');
    onTap(again, () => start());
    p.append(again);
    show(p);
    speak(...promptTalk);
  }

  function title() {
    pos = 0;
    place();
    setPrompt(null, 'かずあそび', ['かずあそび']);
    setHint('おうちの人と一緒に遊んでください。「いくつかな？」と声をかけると、より身につきます');
    const p = el('div', 'panel');
    p.append(el('div', 'emo', '🐣'));
    const go = el('button', 'go', 'はじめる');
    onTap(go, start);
    p.append(go);
    if (S.last === today()) p.append(el('p', '', '今日はもう 1 回遊びました。続けて遊ぶより、明日また遊ぶ方が覚えやすくなります。'));
    show(p);
  }

  function start() {
    // iOS はタップの中で最初に鳴らさないと音が出ないので、ここで一度鳴らす
    tone(660, 0, 0.08, 0.15);
    session();
  }

  title();
</script>
